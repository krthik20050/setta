# Copy to .env in this same project folder. Never commit real keys.
# Text chat (OpenRouter)
SETTA_API_KEY=
# Current experimental voice conversation (Gemini)
GEMINI_API_KEY=
# Sarvam cloned-voice conversation and voice experiments
SARVAM_API_KEY=
# OpenAI decides what to say; Sarvam still recognizes and speaks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DEEP_MODEL=gpt-4.1
# Groq credentials (separate provider; not interchangeable with OpenAI/xAI)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# auto routes by task: OpenAI fast/deep models first, Groq as fallback. Or force groq, openai or sarvam
REPLY_PROVIDER=auto
# Optional local OmniRoute fallback. Use its own gateway key, never the Groq key.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Set an explicitly tested model or combo; blank disables fallback.
OMNIROUTE_MODEL=
# Optional local routing evaluation. Suggestions are logged, never applied.
LAYA_SHADOW=1
# Native partial transcription and patient turn assembly (0 restores legacy REST capture).
SETTA_REALTIME_INPUT=1
# Independently tested chat fallback; uses Sarvam's own quota/credits.
SARVAM_REPLY_FALLBACK=1
